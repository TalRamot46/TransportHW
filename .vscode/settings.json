{
    "files.associations": {
        "*.tex": "latex"
    },

    // latexmk is driven through Strawberry perl because MiKTeX ships latexmk only
    // as a .pl script. -synctex=1 is what makes ctrl+click (inverse search) and
    // ctrl+alt+J (forward search) work; without it no .synctex.gz is written.
    //
    // latexmk is unusable here: a just-written file cannot immediately be
    // overwritten on this machine, so its second pass dies on the output its first
    // pass just produced -- "! I can't write on file `<name>.pdf'", raised at the
    // first shading in the preamble, with no pdf produced.
    //
    // It looked fixed on 2026-08-23 (cold build 2 passes 6.5 s, after an edit 3
    // passes 14.7 s, no change 0.6 s) and came back on 2026-08-28, failing on every
    // ctrl+S. It is intermittent, so a run that succeeds is not evidence it is gone.
    // build.ps1 is therefore the default recipe: it deletes the outputs before every
    // pass, which avoids the collision entirely. See the header of docs/build.ps1.
    // latexmk is kept below only for timing comparisons.
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk (perl)",
            "command": "C:/Strawberry/perl/bin/perl.exe",
            "args": [
                "C:/Users/TLP-001/AppData/Local/Programs/MiKTeX/scripts/latexmk/latexmk.pl",
                "-pdf",
                "-interaction=nonstopmode",
                "-synctex=1",
                "%DOC%"
            ]
        },
        {
            "name": "build.ps1",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '%WORKSPACE_FOLDER%/docs/build.ps1' (Split-Path -Leaf '%DIR%') '%DOCFILE%'"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "build.ps1 (3 passes)",
            "tools": [
                "build.ps1"
            ]
        },
        {
            "name": "latexmk (perl, collides with its own output)",
            "tools": [
                "latexmk (perl)"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",

    "latex-workshop.latex.autoBuild.run": "onSave",

    // Leave the aux files alone: they carry the cross-references, and latexmk needs
    // its .fdb_latexmk to know which passes it can skip.
    "latex-workshop.latex.autoClean.run": "never",

    "latex-workshop.latex.outDir": "%DIR%",
    "latex-workshop.synctex.path": "C:/Users/TLP-001/AppData/Local/Programs/MiKTeX/miktex/bin/x64/synctex.exe",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "ctrl-click",
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.latex.search.rootFiles.include": [
        "docs/homework1/homework1.tex",
        "docs/homework2/homework2.tex",
        "docs/homework3/homework3.tex",
        "docs/homework4/homework4.tex"
    ]
}
